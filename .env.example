# SketchForge Configuration

# Hugging Face Access Token (Required on backend for gated Gemma weights)
HF_TOKEN=

# Model Cache and Device
MODEL_CACHE_DIR=./models
DEVICE=cuda

# Mock Mode (Set to true for local development without GPU)
# Set to false for live production GPU inference
MOCK_MODE=false

# Gemma Model Configuration
GEMMA_MODEL_ID=google/gemma-4-E4B-it
LOAD_IN_4BIT=true

# TripoSR Configuration
TRIPOSR_MODEL_ID=stabilityai/TripoSR
TRIPOSR_CHUNK_SIZE=8192
TRIPOSR_MC_RESOLUTION=256

# Networking & CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000

# Client Configuration (used by frontend in production, e.g. Render)
VITE_API_URL=http://localhost:8000
